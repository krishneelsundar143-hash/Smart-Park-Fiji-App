<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- TODO: Update blank fragment layout -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mvc"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        app:cardCornerRadius="10dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp">

        <ImageView
            android:id="@+id/welcome_image"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:src="@drawable/welcome"
            android:scaleType="centerCrop">
        </ImageView>

        <TextView
            android:id="@+id/welcome_star"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="⭐⭐⭐⭐⭐"
            android:layout_centerInParent="true"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="90dp"
            android:layout_marginBottom="15dp"
            android:textAlignment="center"
            android:textAllCaps="true">
        </TextView>

        <TextView
            android:id="@+id/welcome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="WELCOME"
            android:layout_centerInParent="true"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="110dp"
            android:layout_marginBottom="15dp"
            android:textAlignment="center"
            android:textAllCaps="true">
        </TextView>

    </com.google.android.material.card.MaterialCardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="190dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_gravity="center"
        android:layout_marginTop="5dp">

    <Button
        android:id="@+id/parking"
        android:layout_width="145dp"
        android:layout_height="100dp"
        android:text="Booking\nInformation"
        android:textStyle="bold"
        android:background="@drawable/home_button"
        android:layout_marginTop="40dp"
        android:layout_marginStart="17dp"
        />

    <Button
        android:id="@+id/booked_slots"
        android:layout_width="145dp"
        android:layout_height="100dp"
        android:text="Booked\nSlots"
        android:textStyle="bold"
        android:background="@drawable/home_button"
        android:layout_marginTop="40dp"
        android:layout_marginStart="188dp"/>

    <Button
        android:id="@+id/payment_methods"
        android:layout_width="145dp"
        android:layout_height="100dp"
        android:text="Parking\nVideos"
        android:textAlignment="center"
        android:textStyle="bold"
        android:background="@drawable/home_button"
        android:layout_below="@id/parking"
        android:layout_marginTop="30dp"
        android:layout_marginStart="17dp"/>

    <Button
        android:id="@+id/map"
        android:layout_width="145dp"
        android:layout_height="100dp"
        android:text="Google\nMap"
        android:textStyle="bold"
        android:background="@drawable/home_button"
        android:layout_below="@id/booked_slots"
        android:layout_marginTop="30dp"
        android:layout_marginStart="188dp"/>

    <Button
        android:id="@+id/packing_history"
        android:layout_width="145dp"
        android:layout_height="100dp"
        android:text="Parking\nHistory"
        android:textStyle="bold"
        android:background="@drawable/home_button"
        android:layout_below="@id/payment_methods"
        android:layout_marginTop="30dp"
        android:layout_marginStart="17dp"/>

    <Button
        android:id="@+id/about_us"
        android:layout_width="145dp"
        android:layout_height="100dp"
        android:text="About Us"
        android:textStyle="bold"
        android:background="@drawable/home_button"
        android:layout_below="@id/map"
        android:layout_marginTop="30dp"
        android:layout_marginStart="188dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/packing_history"
        android:textAlignment="center"
        android:layout_marginTop="40dp"
        android:textSize="12dp"
        android:textColor="@color/black"
        android:text="Designed by: Last Moment"/>

    </RelativeLayout>

    </androidx.cardview.widget.CardView>

    </RelativeLayout>

</RelativeLayout>