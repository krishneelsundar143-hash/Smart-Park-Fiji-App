<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SmartPark" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/light_black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:fontFamily">@font/san_francisco_ont</item>
        <item name="android:textColor">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>

        <!-- Customize your theme here. -->

        <item name="actionOverflowButtonStyle">@style/Threedotcolor</item>
        <item name="android:itemTextAppearance">@style/ThemeOverlay.MyPopupTheme.</item>
    </style>

    <style name="Threedotcolor" parent="Widget.AppCompat.Light.ActionButton.Overflow">
        <item name="tint">@color/white</item>
    </style>

    <style name="ThemeOverlay.MyPopupTheme." parent="Theme.AppCompat.Light">

        <item name="android:colorBackground">@color/light_black</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- res/values/styles.xml -->
    <style name="CustomToolbarTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22.5sp</item> <!-- Adjust text size as needed -->
        <item name="android:textColor">@color/blue</item> <!-- Set your text color -->
        <item name="android:fontFamily">@font/roboto_bold</item> <!-- Reference to your custom font -->
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Customize dark theme attributes here -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">true</item> <!-- This is for the status bar text color -->
    </style>

</resources>